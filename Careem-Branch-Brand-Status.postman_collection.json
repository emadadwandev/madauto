{
	"info": {
		"_postman_id": "careem-branch-brand-status-2025",
		"name": "Careem Branch & Brand Status API",
		"description": "Collection for fetching Careem branch and brand status information.\n\nBefore using:\n1. Import the 'Careem Catalog - Staging' environment\n2. Set your client_id, client_secret, brand_id, and branch_id in environment variables\n3. Run \"1. Get Access Token\" first to authenticate\n4. Then run other requests as needed\n\nThe access token is automatically saved and reused.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Get Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save access token to environment",
									"var jsonData = pm.response.json();",
									"",
									"if (jsonData.access_token) {",
									"    pm.environment.set(\"access_token\", jsonData.access_token);",
									"    pm.environment.set(\"token_expires_at\", Date.now() + (jsonData.expires_in * 1000));",
									"    console.log(\"✅ Access token saved successfully\");",
									"    console.log(\"Token expires in: \" + jsonData.expires_in + \" seconds\");",
									"} else {",
									"    console.error(\"❌ No access token in response\");",
									"}",
									"",
									"// Test for successful response",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has access_token\", function () {",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"});",
									"",
									"pm.test(\"Token type is Bearer\", function () {",
									"    pm.expect(jsonData.token_type).to.equal('Bearer');",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Check if required variables are set",
									"const clientId = pm.environment.get(\"client_id\");",
									"const clientSecret = pm.environment.get(\"client_secret\");",
									"",
									"if (!clientId || !clientSecret) {",
									"    console.error(\"❌ Missing credentials!\");",
									"    console.log(\"Please set client_id and client_secret in environment variables\");",
									"} else {",
									"    console.log(\"✅ Credentials found\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{client_id}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{client_secret}}",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "pos",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{token_url}}",
							"host": ["{{token_url}}"]
						},
						"description": "Get OAuth2 access token using client credentials grant type.\n\nThe token is automatically saved to the environment variable `access_token` and will be used in subsequent requests."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for obtaining OAuth2 access tokens."
		},
