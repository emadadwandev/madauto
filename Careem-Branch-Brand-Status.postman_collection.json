								"exec": [
									"// Check if access token exists",
									"const token = pm.environment.get(\"access_token\");",
									"const requestId = pm.environment.get(\"request_id\");",
									"",
									"if (!token) {",
									"    console.error(\"❌ No access token found!\");",
									"    console.log(\"Please run '1. Get Access Token' first\");",
									"}",
									"",
									"if (!requestId) {",
									"    console.warn(\"⚠️ No request_id set!\");",
									"    console.log(\"You'll need to manually replace {request_id} in the URL\");",
									"    console.log(\"Or set request_id in environment variables\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "User-Agent",
								"value": "{{user_agent}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/catalogs/status/{{request_id}}",
							"host": ["{{base_url}}"],
							"path": ["catalogs", "status", "{{request_id}}"]
						},
						"description": "Check the processing status of a catalog upload using the request_id returned from the catalog PUT request.\n\nPossible status values:\n- `pending` - Submitted, awaiting processing\n- `processing` - Being processed\n- `accepted` - Successfully processed\n- `failed` - Processing failed"
					},
					"response": []
				}
			],
			"description": "Endpoints for checking catalog synchronization status."
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"// Check if token is expired",
					"const expiresAt = pm.environment.get(\"token_expires_at\");",
					"if (expiresAt && Date.now() >= expiresAt) {",
					"    console.warn(\"⚠️ Access token has expired. Please get a new token.\");",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"// Log response time",
					"console.log(\"Response time: \" + pm.response.responseTime + \"ms\");"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "https://apigateway-stg.careemdash.com/pos/api/v1",
			"type": "string"
		},
		{
			"key": "token_url",
			"value": "https://identity.qa.careem-engineering.com/token",
			"type": "string"
		}
	]
}
